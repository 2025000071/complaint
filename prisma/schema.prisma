generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Complaint {
  id             String    @id @default(cuid())
  trackingCode   String    @unique // 접수 식별 번호 (예: CMP-2603-9182)
  title          String
  content        String
  category       String    // 시설/환경, 서비스/친절, 제도/규정, 건의사항, 기타
  status         String    @default("PENDING") // PENDING(접수대기), IN_REVIEW(검토중), ANSWERED(답변완료), RESOLVED(해결완료)
  isSecret       Boolean   @default(false)     // 비밀글 여부
  passwordHash   String                        // 비밀번호 해시 (비밀글 열람 및 작성자 댓글/수정용)
  authorNickname String    @default("익명")    // 표시 닉네임
  viewCount      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  boardId        String?
  board          Board?    @relation(fields: [boardId], references: [id], onDelete: SetNull)

  comments       Comment[]

  @@index([boardId, createdAt])
}

model Comment {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  senderType  String    // "ADMIN" | "AUTHOR"
  senderName  String    // e.g. "담당자 (운영팀)", "작성자 (익명)"
  content     String
  createdAt   DateTime  @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String   @default("운영관리자")
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model User {
  id        String         @id @default(cuid())
  email     String?        @unique
  name      String
  role      String         @default("CUSTOMER") // CUSTOMER | ADMIN
  posts     Post[]
  comments  BoardComment[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Board {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  type              String   @default("GENERAL") // GENERAL | INQUIRY | QNA | REVIEW
  description       String?
  isActive          Boolean  @default(true)
  allowSecret       Boolean  @default(false)
  allowAttachments  Boolean  @default(true)
  allowProductLink  Boolean  @default(false)
  posts             Post[]
  complaints        Complaint[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([type, isActive])
}

model Post {
  id           String         @id @default(cuid())
  title        String
  content      String
  isSecret     Boolean        @default(false)
  rating       Int?           // 리뷰 평점은 1~5 범위로 검증
  status       String         @default("PUBLISHED") // PENDING | PUBLISHED | ANSWERED | RESOLVED | HIDDEN
  viewCount    Int            @default(0)
  boardId      String
  board        Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName   String?        // 회원 탈퇴 후에도 작성자 표시를 보존할 때 사용
  passwordHash String?        // 비회원 글 열람/작성자 확인용 해시
  productId    String?        // 상품 모델이 추가되면 해당 모델의 FK로 연결
  images       PostImage[]
  comments     BoardComment[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([boardId, createdAt])
  @@index([boardId, status, createdAt])
  @@index([authorId])
  @@index([productId])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([postId, sortOrder])
}

model BoardComment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorType String   @default("CUSTOMER") // CUSTOMER | ADMIN
  authorName String
  content    String
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
}
